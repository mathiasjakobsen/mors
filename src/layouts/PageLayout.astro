---
import type { Lang } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import StampCardTeaser from '../components/global/StampCardTeaser.astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalPath: string;
  ogImage?: string;
  jsonLd?: object | object[];
  alternatePath?: string | null;
  noindex?: boolean;
  preloadImage?: string;
  /** The first section runs up under a transparent, logo-only header (front page hero). */
  overlayHeader?: boolean;
}

const { title, description, lang, canonicalPath, ogImage, jsonLd, noindex, preloadImage, alternatePath, overlayHeader = false } = Astro.props;
// The stamp card pages already are what the pop-up points to.
const showStampCardTeaser = !['/stempelkort', '/en/stamp-card'].includes(canonicalPath);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  jsonLd={jsonLd}
  noindex={noindex}
  preloadImage={preloadImage}
  alternatePath={alternatePath}
>
  <Header lang={lang} overHero={overlayHeader} alternatePath={alternatePath} />
  <main id="main-content" class:list={['flex-1', !overlayHeader && 'pt-20']}>
    <slot />
  </main>
  <Footer lang={lang} />
  {showStampCardTeaser && <StampCardTeaser lang={lang} />}
</BaseLayout>
