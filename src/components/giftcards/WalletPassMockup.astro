---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Uses left, shown the way the real pass shows it ("5× tilbage"). */
  remaining?: number;
  /** What the pass is good for, mirroring the POS category wording. */
  scope: string;
}

const { lang, remaining = 5, scope } = Astro.props;

// An illustration of the Wallet pass, not a working one. A real pass carries a
// live card number and a scannable code, so the code below is a decorative
// pattern: correct QR furniture (three finder eyes, timing rows) over a
// deterministic fill, seeded so it renders identically on every build.
const QR_SIZE = 21;
let seed = 0x9e37;
const rand = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) >>> 16) & 1;

const isFinder = (x: number, y: number) => {
  const inBox = (ox: number, oy: number) =>
    x >= ox && x < ox + 7 && y >= oy && y < oy + 7;
  return inBox(0, 0) || inBox(QR_SIZE - 7, 0) || inBox(0, QR_SIZE - 7);
};
const finderOn = (x: number, y: number) => {
  const ox = x >= QR_SIZE - 7 ? x - (QR_SIZE - 7) : x;
  const oy = y >= QR_SIZE - 7 ? y - (QR_SIZE - 7) : y;
  const ring = Math.max(Math.abs(ox - 3), Math.abs(oy - 3));
  return ring === 3 || ring <= 1;
};

const modules: { x: number; y: number }[] = [];
for (let y = 0; y < QR_SIZE; y++) {
  for (let x = 0; x < QR_SIZE; x++) {
    if (isFinder(x, y)) {
      if (finderOn(x, y)) modules.push({ x, y });
    } else if (x === 6 || y === 6) {
      if ((x + y) % 2 === 0) modules.push({ x, y });
    } else if (rand()) {
      modules.push({ x, y });
    }
  }
}

const label = lang === 'da'
  ? { remaining: 'Tilbage', yours: 'Dit gavekort', name: 'Navn', to: 'Til dig', show: 'Vis QR-koden ved baren' }
  : { remaining: 'Remaining', yours: 'Your gift card', name: 'Name', to: 'For you', show: 'Show the QR code at the bar' };
---

<!-- Phone frame -->
<div class="relative mx-auto w-full max-w-[18rem]">
  <div class="rounded-[2.5rem] bg-ink p-2.5 shadow-[0_30px_60px_-20px_rgba(26,26,26,0.45)]">
    <div class="rounded-[2rem] bg-black px-3 pb-6 pt-5">
      <!-- Pass. #2D1D14 is the real pass background. -->
      <div class="rounded-2xl p-5 text-white" style="background:#2D1D14">
        <div class="flex items-start justify-between gap-4">
          <img
            src="/brand/mors-wordmark.svg"
            alt="morˢ"
            width="70"
            height="20"
            class="h-5 w-auto [filter:brightness(0)_invert(1)]"
          />
          <div class="text-right leading-tight">
            <p class="font-body text-[9px] uppercase tracking-[0.18em] text-gold">{label.remaining}</p>
            <p class="font-body text-xl font-normal">{remaining}&times;</p>
          </div>
        </div>

        <p class="font-body text-[13px] font-light leading-snug mt-5 text-white/90">{scope}</p>

        <p class="font-body text-[13px] font-light mt-5 text-white/90">{label.yours}</p>

        <p class="font-body text-[9px] uppercase tracking-[0.18em] text-gold mt-5">{label.name}</p>
        <p class="font-body text-base font-light">{label.to}</p>

        <div class="mt-5 rounded-lg bg-white p-2.5">
          <svg viewBox={`0 0 ${QR_SIZE} ${QR_SIZE}`} class="w-full h-auto" aria-hidden="true" shape-rendering="crispEdges">
            <rect width={QR_SIZE} height={QR_SIZE} fill="#fff" />
            {modules.map((m) => (
              <rect x={m.x} y={m.y} width="1" height="1" fill="#2D1D14" />
            ))}
          </svg>
        </div>

        <p class="font-body text-[10px] text-center mt-3 text-gold/90">{label.show}</p>
      </div>
    </div>
  </div>
</div>
