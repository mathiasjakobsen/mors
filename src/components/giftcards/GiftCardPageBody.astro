---
import type { Lang } from '../../i18n/ui';
import { t, getLocalizedPath } from '../../i18n/ui';
import { getGiftCards } from '../../lib/api';
import Container from '../shared/Container.astro';
import ProductGrid from '../shared/ProductGrid.astro';
import GiftCardVisual from '../shared/GiftCardVisual.astro';
import PageHero from '../shared/PageHero.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import WalletPassMockup from './WalletPassMockup.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const giftCards = await getGiftCards();
const menuPath = getLocalizedPath(lang, '/menu');

const currency = lang === 'da' ? 'kr.' : 'DKK';

// Whole kroner stay whole ("200 kr."); a per-clip price that lands between
// them gets two decimals, with the separator the locale expects.
function money(amount: number): string {
  const formatted = new Intl.NumberFormat(lang === 'da' ? 'da-DK' : 'en-GB', {
    minimumFractionDigits: Number.isInteger(amount) ? 0 : 2,
    maximumFractionDigits: 2,
  }).format(amount);
  return `${formatted} ${currency}`;
}


// "Best per clip" is derived, not editorial: it flags the card with the lowest
// price per clip, and only when there is something to compare it against.
// Today's 4-clip and 10-clip cards tie at 37.50 kr., so ties go to the card
// with the most clips — exactly one badge, on the bigger commitment.
const comparable = giftCards.filter((c) => !!c.clips && c.clips > 0);
const bestValueId =
  comparable.length > 1
    ? comparable.reduce((best, c) => {
        const a = c.price / c.clips!;
        const b = best.price / best.clips!;
        return a < b || (a === b && c.clips! > best.clips!) ? c : best;
      }).id
    : null;

// A description every card shares is POS boilerplate, not per-card
// information — today it is "Gavekort. Indløses ved disken — et klip pr. vare.",
// which both repeats badly three-across and describes the old physical card.
// How redemption actually works is the job of the steps, the Wallet section and
// the FAQ, so the boilerplate is dropped. A card with wording of its own still
// shows it. (Fix the text in the staff PWA, not here — see CLAUDE.md.)
const firstDescription = giftCards[0]?.description?.[lang] ?? null;
const isBoilerplate =
  !!firstDescription && giftCards.every((c) => c.description?.[lang] === firstDescription);

const steps = [
  { title: t(lang, 'giftcards.how.step1.title'), body: t(lang, 'giftcards.how.step1.body') },
  { title: t(lang, 'giftcards.how.step2.title'), body: t(lang, 'giftcards.how.step2.body') },
  { title: t(lang, 'giftcards.how.step3.title'), body: t(lang, 'giftcards.how.step3.body') },
];

const faqs = [
  { q: t(lang, 'giftcards.faq.q1'), a: t(lang, 'giftcards.faq.a1'), menuLink: false },
  { q: t(lang, 'giftcards.faq.q2'), a: t(lang, 'giftcards.faq.a2'), menuLink: true },
  { q: t(lang, 'giftcards.faq.q3'), a: t(lang, 'giftcards.faq.a3'), menuLink: false },
  { q: t(lang, 'giftcards.faq.q4'), a: t(lang, 'giftcards.faq.a4'), menuLink: false },
  { q: t(lang, 'giftcards.faq.q5'), a: t(lang, 'giftcards.faq.a5'), menuLink: false },
];

// The pass illustration quotes a real card's wording. Prefer the scope of an
// actual drinks card from the API so the mockup stays true if the POS wording
// changes; fall back to the first card.
const showcased = giftCards.find((c) => c.clips === 5) ?? giftCards[0];
const passScope = showcased?.name[lang] ?? '';
const passRemaining = showcased?.clips ?? 5;

const stepDelays = ['[transition-delay:0.1s]', '[transition-delay:0.2s]', '[transition-delay:0.3s]'];
const tilts = [-3, 2, -1.5];
---

<PageHero title={t(lang, 'giftcards.title')} lead={t(lang, 'giftcards.lead')} />

<!-- The cards, drawn as the Wallet passes they become (same as on the front
     page, larger), with price and price per use underneath. -->
<section class="bg-warm-white py-20 md:py-28">
  <Container>
    <ProductGrid>
      {giftCards.map((card, i) => {
        const perClip = card.clips && card.clips > 0 ? card.price / card.clips : null;
        const isBest = card.id === bestValueId;
        return (
          <article
            data-animate-on-scroll
            class:list={[
              'group relative flex flex-col opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out',
              !card.inStock && 'opacity-60',
              stepDelays[i % 3],
            ]}
          >
            {isBest && (
              <span class="absolute -top-3 left-5 z-10 bg-gold text-ink text-[10px] font-body font-semibold uppercase tracking-[0.18em] px-3 py-1 rounded-full shadow-sm">
                {t(lang, 'giftcards.bestValue')}
              </span>
            )}

            <GiftCardVisual card={card} lang={lang} size="lg" tilt={tilts[i % tilts.length]} />

            {card.description && !isBoilerplate && (
              <p class="font-body font-light text-sm text-ink-light leading-relaxed mt-6">
                {card.description[lang]}
              </p>
            )}

            <div class="mt-6 flex items-baseline justify-between gap-3">
              <span class="font-display font-bold text-2xl text-ink whitespace-nowrap">
                {money(card.price)}
              </span>
              {perClip !== null && (
                <span class="font-body font-light text-sm text-ink-muted whitespace-nowrap">
                  {money(perClip)} {t(lang, 'giftcards.perClip')}
                </span>
              )}
            </div>
            {!card.inStock && (
              <p class="font-body font-normal text-xs uppercase tracking-[0.15em] text-ink-muted mt-3">
                {t(lang, 'common.outOfStock')}
              </p>
            )}
          </article>
        );
      })}
    </ProductGrid>

    <p class="mt-12 text-center font-body font-light text-sm uppercase tracking-[0.2em] text-ink-muted">
      {t(lang, 'giftcards.cards.subtitle')}
    </p>
  </Container>
</section>

<!-- How it works -->
<section class="bg-cream py-24 md:py-40">
  <Container>
    <SectionHeading secondary title={t(lang, 'giftcards.how.title')} />

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16 max-w-5xl mx-auto">
      {steps.map((step, i) => (
        <li
          data-animate-on-scroll
          class:list={[
            'opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out',
            stepDelays[i],
          ]}
        >
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full border border-deep-red/20 font-display font-semibold text-xl text-deep-red mb-6"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="font-display font-semibold text-xl tracking-normal text-deep-red mb-3">
            {step.title}
          </h3>
          <p class="font-body font-light text-ink-light leading-relaxed">
            {step.body}
          </p>
        </li>
      ))}
    </ol>
  </Container>
</section>

<!-- Wallet showcase -->
<section class="bg-cream pb-24 md:pb-40">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-20 items-center max-w-5xl mx-auto">
      <div data-animate-on-scroll class="order-2 md:order-1 opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out">
        <h2 class="font-display font-bold text-lg md:text-xl uppercase text-deep-red mb-6">
          {t(lang, 'giftcards.wallet.title')}
        </h2>
        <p class="font-body font-light text-lg text-ink-light leading-relaxed mb-8">
          {t(lang, 'giftcards.wallet.body')}
        </p>
        <p class="font-body font-normal text-sm uppercase tracking-[0.18em] text-sage">
          {t(lang, 'giftcards.wallet.note')}
        </p>
      </div>

      <div data-animate-on-scroll class="order-1 md:order-2 opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out [transition-delay:0.15s]">
        <WalletPassMockup lang={lang} scope={passScope} remaining={passRemaining} />
      </div>
    </div>
  </Container>
</section>

<!-- FAQ -->
<section class="bg-warm-white py-24 md:py-40">
  <Container>
    <SectionHeading secondary title={t(lang, 'giftcards.faq.title')} />

    <div class="max-w-2xl mx-auto">
      {faqs.map((faq) => (
        <details class="faq-item border-b border-ink/10">
          <summary class="faq-summary flex items-center justify-between gap-6 cursor-pointer py-6 font-body font-normal text-lg text-ink hover:text-deep-red transition-colors">
            {faq.q}
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              aria-hidden="true"
              class="faq-icon w-4 h-4 shrink-0 text-deep-red transition-transform duration-300"
            >
              <path d="M8 2v12" class="faq-icon-bar" />
              <path d="M2 8h12" />
            </svg>
          </summary>
          <div class="faq-body pb-6">
            <p class="font-body font-light text-ink-light leading-relaxed">
              {faq.a}
            </p>
            {faq.menuLink && (
              <a
                href={menuPath}
                class="inline-flex items-center gap-2 mt-3 font-body font-normal text-deep-red hover:text-ink transition-colors group"
              >
                {t(lang, 'giftcards.seeMenu')}
                <svg viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
                  <path d="M1 7h21" />
                  <path d="M16 2l5 5-5 5" />
                </svg>
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

<style>
  /* Native disclosure, no JavaScript. The height animation needs
     `interpolate-size: allow-keywords` from global.css; browsers without
     ::details-content support just open and close instantly. */
  .faq-summary {
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    content-visibility: hidden;
    transition:
      block-size 350ms ease,
      content-visibility 350ms allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }

  /* Plus turns into a minus when the answer is open. */
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
  .faq-icon-bar {
    transition: opacity 300ms ease;
  }
  .faq-item[open] .faq-icon-bar {
    opacity: 0;
  }
</style>
