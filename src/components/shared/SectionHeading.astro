---
interface Props {
  /** Optional: a section can be introduced by its subtitle alone. */
  title?: string;
  subtitle?: string;
  /** Tighter spacing, for the shorter front page sections. */
  compact?: boolean;
  /** A sub-heading on an inner page: Roboto caps instead of Mors Display,
   *  which is kept for primary titles. */
  secondary?: boolean;
}

const { title, subtitle, compact = false, secondary = false } = Astro.props;
---

<div data-animate-on-scroll class:list={['text-center opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out', compact ? 'mb-8 md:mb-10' : 'mb-16 md:mb-20']}>
  {title && (
    <h2 class:list={['text-deep-red mb-4', secondary ? 'font-display font-bold text-xl md:text-2xl uppercase' : 'font-mors font-medium text-4xl md:text-5xl']}>
      {title}
    </h2>
  )}
  {subtitle && (
    <p class:list={['font-body font-light text-ink-light max-w-xl mx-auto leading-relaxed uppercase tracking-[0.2em]', compact ? 'text-base' : 'text-lg']}>
      {subtitle}
    </p>
  )}
</div>
