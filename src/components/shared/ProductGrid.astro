---
// The one grid for product listings (beans, ceramics, gift cards): one column
// on phones, two on tablets, three from lg up.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12', className]}>
  <slot />
</div>
