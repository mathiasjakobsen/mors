---
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { config } from '../../config';
import { QR_SIZE, qrPattern } from '../../lib/qr-pattern';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// A stamp card peeking in from the right edge, drawn like the real Wallet pass
// (EDB's Loyalty::AppleStampPass colours and its 10-slot stamp strip), with a
// hand-drawn arrow and typed-out line pointing at it. Clicking it opens the
// sign-up promo in EDB. Dismissal is remembered per browser.
const modules = qrPattern();
const SLOTS = 10;
const STAMPED = 1;
// Split after the dash: in the compact layout the line always breaks there
// (two lines next to the card); otherwise the <br> is hidden and it wraps on
// its own.
const [line1, line2 = ''] = t(lang, 'stampcard.teaser.text').split(/(?<=– )/);
---

<div id="stampcard-teaser" class="st print:hidden" hidden>
  <div class="st-slide">
    <!-- Every character is rendered up front and revealed one by one, so the
         line breaks are fixed before typing starts and nothing reflows. -->
    <p class="st-note font-mors font-medium text-deep-red">
      <span aria-hidden="true">{[...line1].map((ch) => <span class="st-ch">{ch}</span>)}<br class="st-br" />{[...line2].map((ch) => <span class="st-ch">{ch}</span>)}</span>
      <!-- Close sits on the text's top-right corner and moves with it. -->
      <button type="button" class="st-close" aria-label={t(lang, 'stampcard.teaser.dismiss')} data-st-close>
        <svg viewBox="0 0 12 12" class="h-2.5 w-2.5" aria-hidden="true">
          <path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </p>

    <svg class="st-arrow text-deep-red" viewBox="0 0 120 90" fill="none" aria-hidden="true">
      <path
        class="st-arrow-shaft"
        pathLength="1"
        d="M10 6 C 22 40, 52 70, 104 74"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <path
        class="st-arrow-head"
        pathLength="1"
        d="M90 62 L 105 74 L 88 84"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <a
      href={config.stampCardSignupUrl}
      class="st-card"
      aria-label={t(lang, 'stampcard.teaser.label')}
      data-umami-event="stampcard-teaser-click"
    >
      <div class="st-wiggle">
        <!-- Pass face. Colours are the pkpass background/label colours. -->
        <div class="st-pass">
          <div class="flex items-start justify-between gap-3">
            <img
              src="/brand/mors-wordmark-white.svg"
              alt=""
              width="64"
              height="18"
              class="h-[18px] w-auto mt-0.5"
            />
            <div class="text-right leading-tight">
              <p class="text-[8px] uppercase tracking-[0.18em] st-gold">{t(lang, 'stampcard.teaser.stamps')}</p>
              <p class="text-base tabular-nums">{STAMPED}/{SLOTS}</p>
            </div>
          </div>

          <svg viewBox="0 0 220 34" class="mt-4 block w-full h-auto" aria-hidden="true">
            {Array.from({ length: SLOTS }, (_, i) => {
              const cx = 11 + i * 22;
              return i < STAMPED
                ? <circle cx={cx} cy="17" r="8" fill="#d4b078" />
                : <circle cx={cx} cy="17" r="7" fill="none" stroke="#d4b078" stroke-width="2" opacity="0.45" />;
            })}
          </svg>

          <p class="st-rules text-[10px] font-light mt-3 text-white/85">{t(lang, 'stampcard.teaser.rules')}</p>

          <div class="mt-3 mx-auto w-[58%] rounded-md bg-white p-1.5">
            <svg viewBox={`0 0 ${QR_SIZE} ${QR_SIZE}`} class="block w-full h-auto" aria-hidden="true" shape-rendering="crispEdges">
              {modules.map((m) => (
                <rect x={m.x} y={m.y} width="1" height="1" fill="#2D1D14" />
              ))}
            </svg>
          </div>
        </div>
      </div>
    </a>

  </div>
</div>

<style>
  .st {
    --card-w: 210px;
    --tilt: -12deg;
    --peek: 18%;
    position: fixed;
    right: 0;
    bottom: 14vh;
    z-index: 40;
    width: var(--card-w);
    pointer-events: none;
  }
  /* Compact layout (set by the script: below lg, or wherever the full layout
     would land on the page's [data-teaser-avoid] content): a smaller card, low,
     with the line and arrow to its left instead of above. It all tucks away
     while the page scrolls so it never sits on what is being read. */
  .st.is-compact { --card-w: 120px; --peek: 22%; bottom: 24px; }
  .st.is-compact.is-in.is-tucked .st-slide { transform: translateX(88%); }
  .st.is-compact .st-note, .st.is-compact .st-arrow { transition: opacity 0.2s ease; }
  .st.is-compact.is-tucked .st-note, .st.is-compact.is-tucked .st-arrow,
  .st.is-compact.is-quiet .st-note, .st.is-compact.is-quiet .st-arrow { opacity: 0; }

  /* Outer layer: slides in from off-screen, and further out on hover. */
  .st-slide {
    position: relative;
    transform: translateX(140%);
    transition: transform 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .st.is-in .st-slide { transform: translateX(var(--peek)); }
  .st.is-in .st-slide:has(.st-card:hover, .st-card:focus-visible) { transform: translateX(4%); }

  .st-card {
    display: block;
    pointer-events: auto;
    border-radius: 16px;
    outline-offset: 4px;
  }

  /* Inner layer: tilted, tethered to the right edge, with a wiggle every few
     seconds. Separate from the slide layer so the two transforms never fight. */
  .st-wiggle {
    transform-origin: 100% 50%;
    transform: rotate(var(--tilt));
    transition: transform 0.4s ease;
  }
  .st.is-in .st-wiggle { animation: st-wiggle 4.5s ease-in-out 1.2s infinite; }
  .st-card:hover .st-wiggle,
  .st-card:focus-visible .st-wiggle {
    animation: none;
    transform: rotate(-5deg);
  }
  @keyframes st-wiggle {
    0%, 78%, 100% { transform: rotate(var(--tilt)); }
    82% { transform: rotate(calc(var(--tilt) + 6deg)); }
    86% { transform: rotate(calc(var(--tilt) - 4deg)); }
    90% { transform: rotate(calc(var(--tilt) + 3deg)); }
    94% { transform: rotate(calc(var(--tilt) - 1.5deg)); }
  }

  .st-pass {
    background: #2D1D14;
    color: rgb(251, 246, 238);
    border-radius: 16px;
    padding: 14px;
    box-shadow: 0 24px 40px -14px rgba(26, 26, 26, 0.5), 0 2px 6px rgba(26, 26, 26, 0.2);
  }
  .st.is-compact .st-pass { padding: 10px; }
  .st.is-compact .st-rules { display: none; }
  .st-gold { color: #d4b078; }

  /* Annotation: typed line, and an arrow curving down into the card. */
  .st-note {
    position: absolute;
    right: calc(100% - 10px);
    bottom: calc(100% + 68px);
    width: 220px;
    font-size: 24px;
    line-height: 1.1;
    text-align: right;
    transform: rotate(-4deg);
  }
  .st-arrow {
    position: absolute;
    right: calc(100% - 6px);
    bottom: calc(100% - 12px);
    width: 96px;
    height: auto;
  }
  .st.is-compact .st-note {
    right: calc(100% + 30px);
    bottom: calc(14% + 26px);
    width: max-content;
    font-size: 15px;
    /* A cream halo keeps it legible over whatever it lands on. */
    text-shadow: 0 0 6px #F5F0E8, 0 0 12px #F5F0E8;
  }
  .st.is-compact .st-arrow { right: calc(100% + 2px); bottom: 14%; width: 44px; }
  .st:not(.is-compact) .st-br { display: none; }
  .st-arrow path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .st.is-drawn .st-arrow-shaft { transition: stroke-dashoffset 0.7s ease-out; stroke-dashoffset: 0; }
  .st.is-drawn .st-arrow-head { transition: stroke-dashoffset 0.25s ease-out 0.65s; stroke-dashoffset: 0; }

  .st-ch { visibility: hidden; }
  .st-ch.is-shown { visibility: visible; }
  /* The caret rides on the last revealed character. */
  .st.is-typing .st-ch.is-caret { animation: st-blink 0.8s steps(1) infinite; }
  @keyframes st-blink { 50% { box-shadow: none; } }
  .st.is-typing .st-ch.is-caret { box-shadow: 3px 0 0 -1px currentColor; }

  .st-close {
    position: absolute;
    top: -20px;
    right: -22px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: #FDFBF7;
    color: #1A1A1A;
    box-shadow: 0 2px 6px rgba(26, 26, 26, 0.25);
    pointer-events: auto;
    opacity: 0;
    transition: opacity 0.3s ease 1s;
  }
  .st.is-in .st-close { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .st-slide, .st-wiggle { transition: none; }
    .st.is-in .st-wiggle { animation: none; }
    .st.is-drawn .st-arrow path { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'mors:stampcard-teaser-dismissed';
    var el = document.getElementById('stampcard-teaser');
    if (!el) return;
    try { if (localStorage.getItem(KEY)) return; } catch (e) {}

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var chars = el.querySelectorAll('.st-ch');

    el.hidden = false;

    // Pick the layout by measuring, not by breakpoint alone: where would the
    // card, line and arrow rest, and does that land on any [data-teaser-avoid]
    // element (page coordinates, as those scroll and the teaser does not)?
    // The full layout is used when it fits (never below lg), else compact. If
    // even compact does not fit, the teaser waits until the hero is scrolled
    // past.
    var slide = el.querySelector('.st-slide');
    var parts = ['.st-note', '.st-arrow', '.st-card'].map(function (q) { return el.querySelector(q); });
    function collides(asCompact) {
      el.classList.toggle('is-compact', asCompact);
      slide.style.transition = 'none';
      slide.style.transform = 'translateX(var(--peek))';
      var mine = parts.map(function (n) { return n.getBoundingClientRect(); });
      slide.style.transform = '';
      void slide.offsetWidth;
      slide.style.transition = '';
      return Array.prototype.some.call(document.querySelectorAll('[data-teaser-avoid]'), function (a) {
        var r = a.getBoundingClientRect();
        var top = r.top + window.scrollY, bottom = r.bottom + window.scrollY;
        return mine.some(function (m) {
          return m.left < r.right && m.right > r.left && m.top < bottom && m.bottom > top;
        });
      });
    }
    var compact, waitForScroll;
    function layout() {
      compact = window.matchMedia('(max-width: 1023px)').matches || collides(false);
      waitForScroll = compact && collides(true);
      el.classList.toggle('is-compact', compact);
    }
    layout();
    var resized;
    window.addEventListener('resize', function () {
      clearTimeout(resized);
      resized = setTimeout(layout, 200);
    });
    el.querySelector('[data-st-close]').addEventListener('click', function () {
      el.remove();
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // Tucked while scrolling; only has a visual effect when compact (see CSS).
    // There the line and arrow are said once: the first scroll after they
    // have been typed out fades them for good, so they never sit on content.
    var idle, said = false;
    window.addEventListener('scroll', function () {
      if (said) el.classList.add('is-quiet');
      el.classList.add('is-tucked');
      clearTimeout(idle);
      idle = setTimeout(function () { el.classList.remove('is-tucked'); }, 700);
    }, { passive: true });

    function start() {
      if (reduced) {
        chars.forEach(function (c) { c.classList.add('is-shown'); });
        el.classList.add('is-in', 'is-drawn');
        said = true;
        return;
      }
      // Card slides in, then the arrow draws, then the line types itself out.
      requestAnimationFrame(function () { el.classList.add('is-in'); });
      setTimeout(function () { el.classList.add('is-drawn'); }, 700);
      setTimeout(function () {
        el.classList.add('is-typing');
        var i = 0;
        var tick = setInterval(function () {
          if (i > 0) chars[i - 1].classList.remove('is-caret');
          chars[i].classList.add('is-shown', 'is-caret');
          if (++i >= chars.length) {
            clearInterval(tick);
            setTimeout(function () { el.classList.remove('is-typing'); said = true; }, 1600);
          }
        }, 45);
      }, 1500);
    }

    if (waitForScroll) {
      var onScroll = function () {
        if (window.scrollY < window.innerHeight * 0.6) return;
        window.removeEventListener('scroll', onScroll);
        start();
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    } else {
      setTimeout(start, 1000);
    }
  })();
</script>
