---
import type { Lang } from '../../i18n/ui';
import { t, getNavItems, getLocalizedPath } from '../../i18n/ui';
import { config } from '../../config';
import { getHoursSummary } from '../../data/hours';
import SocialLinks from '../shared/SocialLinks.astro';
import NavCount from './NavCount.astro';
import { upcomingEvents } from '../../data/events';
import { getViden, LEGAL_PATHS } from '../../lib/content';
import { getBrewGuides } from '../../lib/api';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Contact details are right next to it in the footer, so no link to the contact page.
// Content sections only show up once something in them is published.
const emptySections = new Set([
  ...((await getBrewGuides(lang)).length ? [] : ['brewguides']),
  ...((await getViden(lang)).length ? [] : ['knowledge']),
]);
const navItems = getNavItems(lang).filter((item) => item.key !== 'contact' && !emptySections.has(item.key));

// The footer groups the nav into what happens in the kaffebar, what you can
// buy, and what you can read. Item order inside a group follows this list.
// Footer columns: (1) brand + Findsmiley, (2) kaffebar + shop,
// (3) learn, "featured on" and social, (4) hours and contact.
const toGroup = (label: string, keys: string[]) => ({
  label,
  items: keys
    .map((key) => navItems.find((item) => item.key === key))
    .filter((item): item is (typeof navItems)[number] => !!item),
});
const barAndShopGroups = [
  toGroup(t(lang, 'footer.group.bar'), ['menu', 'breakfast', 'events', 'stampcard', 'about']),
  toGroup(t(lang, 'footer.group.shop'), ['beans', 'products', 'giftcards', 'business']),
];
const learnGroup = toGroup(t(lang, 'footer.group.learn'), ['brewguides', 'knowledge']);

const heading = 'font-body text-xs uppercase tracking-[0.2em] text-cream/50';
const link = 'inline-flex items-center gap-2 text-cream/70 font-body font-light hover:text-cream transition-colors w-fit';
const homePath = getLocalizedPath(lang, '/');
const hoursSummary = getHoursSummary(lang);
const jobsPath = lang === 'da' ? '/job' : '/en/jobs';

// Danish keeps the compact DD-MM-YY the Fødevarestyrelsen reports use; English
// spells the month out so DD-MM isn't misread as MM-DD.
const [smileyYear, smileyMonth, smileyDay] = config.findsmiley.date.split('-');
const smileyDate =
  lang === 'da'
    ? `${smileyDay}-${smileyMonth}-${smileyYear.slice(2)}`
    : new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(`${config.findsmiley.date}T00:00:00Z`));
---

<footer data-teaser-on-dark class="bg-ink text-cream relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-24 md:py-32 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16 lg:gap-x-12">
      <!-- Column 1: Brand -->
      <div class="col-span-2 lg:col-span-1">
        <a href={homePath} class="inline-block" aria-label="morˢ">
          <img
            src="/brand/mors-wordmark.svg"
            alt="morˢ"
            width="140"
            height="40"
            class="h-10 w-auto [filter:brightness(0)_invert(1)] opacity-90 hover:opacity-100 transition-opacity"
          />
        </a>
        <p class="mt-4 text-cream/60 font-body font-light leading-relaxed max-w-xs text-lg">
          {t(lang, 'footer.tagline')}
        </p>

        <!-- Findsmiley badge -->
        <div class="mt-6">
          <a
            href={config.findsmiley.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
            aria-label={lang === 'da' ? 'Smiley rapport' : 'Smiley report'}
          >
            <img
              src={config.findsmiley.image}
              alt="Fødevarekontrol smiley"
              width="60"
              height="60"
              loading="lazy"
              class="[filter:brightness(0)_invert(1)] opacity-70 hover:opacity-100 transition-opacity"
            />
          </a>
          <a
            href={config.findsmiley.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex w-fit items-center gap-2 text-cream/70 font-body font-light hover:text-cream transition-colors group"
          >
            {lang === 'da' ? 'Smiley rapport' : 'Smiley report'}
            <svg viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-3 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
              <path d="M1 7h21" />
              <path d="M16 2l5 5-5 5" />
            </svg>
          </a>
          <p class="mt-1 text-xs font-body font-light text-cream/50">
            <time datetime={config.findsmiley.date}>{smileyDate}</time>
          </p>
        </div>
      </div>

      <!-- Column 2: the kaffebar and the shop -->
      <div class="flex flex-col gap-12">
        {barAndShopGroups.map((group) => (
          <div>
            <h3 class:list={[heading, 'mb-6']}>{group.label}</h3>
            <nav class="flex flex-col gap-3" aria-label={group.label}>
              {group.items.map((item) => (
                <a href={item.href} class={link}>
                  {item.label}
                  {item.key === 'events' && <NavCount count={upcomingEvents().length} />}
                </a>
              ))}
            </nav>
          </div>
        ))}
      </div>

      <!-- Column 3: learn about coffee, where we're featured, social -->
      <div class="flex flex-col gap-12">
        {learnGroup.items.length > 0 && (
          <div>
            <h3 class:list={[heading, 'mb-6']}>{learnGroup.label}</h3>
            <nav class="flex flex-col gap-3" aria-label={learnGroup.label}>
              {learnGroup.items.map((item) => (
                <a href={item.href} class={link}>{item.label}</a>
              ))}
            </nav>
          </div>
        )}

        <div>
          <h3 class:list={[heading, 'mb-4']}>{lang === 'da' ? 'Anbefalet på' : 'Featured on'}</h3>
          <ul class="flex flex-col gap-2">
            <li>
              <a
                href="https://www.google.com/maps/search/?api=1&query=mors%2C+Klostergade+58%2C+8000+Aarhus"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-cream/70 font-body font-light hover:text-cream transition-colors group"
              >
                Google
                <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-3 h-3 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
                  <path d="M3 11l8-8" />
                  <path d="M5 3h6v6" />
                </svg>
              </a>
            </li>
            <li>
              <a
                href="https://www.tripadvisor.dk/Restaurant_Review-g15152405-d34392839-Reviews-Mors-Edslev_Aarhus_East_Jutland_Jutland.html"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-cream/70 font-body font-light hover:text-cream transition-colors group"
              >
                Tripadvisor
                <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-3 h-3 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
                  <path d="M3 11l8-8" />
                  <path d="M5 3h6v6" />
                </svg>
              </a>
            </li>
            <li>
              <a
                href="https://europeancoffeetrip.com/cafe/mors-aarhus/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-cream/70 font-body font-light hover:text-cream transition-colors group"
              >
                European Coffee Trip
                <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-3 h-3 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
                  <path d="M3 11l8-8" />
                  <path d="M5 3h6v6" />
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class:list={[heading, 'mb-6']}>{t(lang, 'footer.followUs')}</h3>
          <SocialLinks lang={lang} variant="light" />
        </div>
      </div>

      <!-- Column 4: opening hours and contact -->
      <div class="col-span-2 lg:col-span-1">
        <h3 class:list={[heading, 'mb-4']}>{t(lang, 'hours.title')}</h3>
        <div class="flex flex-col gap-1.5">
          {hoursSummary.map((line) => (
            <span class="text-cream/60 font-body font-light">{line}</span>
          ))}
        </div>

        <h3 class:list={[heading, 'mt-12 mb-6']}>{t(lang, 'contact.title')}</h3>
        <address class="not-italic text-cream/70 font-body font-light leading-loose">
          <p>{config.address.street}</p>
          <p>{config.address.zip} {config.address.city}</p>
          <p class="mt-3">
            <a href={`tel:${config.phoneTel}`} class="hover:text-cream transition-colors">{config.phone}</a>
          </p>
          <p>
            <a href={`mailto:${config.email}`} class="hover:text-cream transition-colors">{config.email}</a>
          </p>
          <!-- Leads to the jobs page, which explains what to send to job@. -->
          <p class="mt-3 italic text-cream/45">{t(lang, 'footer.jobs.prompt')}</p>
          <p>
            <a href={jobsPath} class="hover:text-cream transition-colors">{config.jobEmail}</a>
          </p>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-cream/5 relative z-10">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-cream/60 text-xs font-body font-light">
        &copy; {new Date().getFullYear()} {config.legalName} (CVR: {config.cvr}). {lang === 'da' ? 'Alle rettigheder forbeholdes.' : 'All rights reserved.'}
      </p>
      <nav class="flex items-center gap-6" aria-label={lang === 'da' ? 'Politikker' : 'Policies'}>
        <a href={LEGAL_PATHS.privacy[lang]} class="text-cream/60 hover:text-cream text-xs font-body font-light transition-colors">
          {lang === 'da' ? 'Privatlivspolitik' : 'Privacy policy'}
        </a>
        <a href={LEGAL_PATHS.cookies[lang]} class="text-cream/60 hover:text-cream text-xs font-body font-light transition-colors">
          {lang === 'da' ? 'Cookiepolitik' : 'Cookie policy'}
        </a>
      </nav>
    </div>
  </div>
</footer>
