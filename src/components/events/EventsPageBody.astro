---
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { config } from '../../config';
import { upcomingEvents } from '../../data/events';
import { getTicketedEvents, type TicketDate, type TicketedEvent } from '../../lib/api';
import Container from '../shared/Container.astro';
import PageHero from '../shared/PageHero.astro';
import PhotoStack from '../shared/PhotoStack.astro';
import FollowDialog from './FollowDialog.astro';
// Stand-ins until there are photos from an actual event: swap these for the
// real ones (back to front), alt texts included.
import cafe from '../../assets/mors-cafe.jpg';
import baren from '../../assets/mors-baren.jpg';
import bagBaren from '../../assets/mors-bag-baren.jpg';
import morgenmad from '../../assets/mors-morgenmad.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const mailto = (subject: string) => `mailto:${config.email}?subject=${encodeURIComponent(subject)}`;
// "Giv mig besked" leaves an e-mail in EDB against the event id (EventFollow).
// It opens in a modal (FollowDialog below); the link is the fallback.
const followUrl = (id: string) => `${config.eventsUrl}/${encodeURIComponent(id)}/følg`;
const events = upcomingEvents();

// "Fredag 27. november, kl. 17.00–20.00" / "Friday 27 November, 17:00–20:00".
function eventDate(iso: string, time?: { from: string; to: string }): string {
  const day = new Intl.DateTimeFormat(lang === 'da' ? 'da-DK' : 'en-GB', {
    weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC',
  }).format(new Date(`${iso}T00:00:00Z`));
  const s = day.charAt(0).toUpperCase() + day.slice(1);
  if (!time) return s;
  // Danish writes clock times with a dot.
  const clock = (hhmm: string) => (lang === 'da' ? hhmm.replace(':', '.') : hhmm);
  return `${s}, ${lang === 'da' ? 'kl. ' : ''}${clock(time.from)}–${clock(time.to)}`;
}
// Events staff sell tickets to in EDB (/api/v1/events). One whose slug matches
// an id below keeps the site's own copy and gains its real dates and a buy
// button; one the site does not know yet is listed with EDB's public copy.
const ticketed = await getTicketedEvents();
const ownIds = new Set(events.map((e) => e.id));

interface Row {
  key: string;
  kind: string;
  title: string;
  body: string;
  date?: string;
  time?: { from: string; to: string };
  duration?: string;
  priceKr?: number;
  cta: 'signup' | 'notify';
  tickets?: TicketedEvent;
}

const rows: Row[] = [
  ...events.map((e) => ({
    key: e.id, kind: e.kind[lang], title: e.title[lang], body: e.body[lang], date: e.date, time: e.time,
    duration: e.duration?.[lang], priceKr: e.priceKr, cta: e.cta,
    tickets: ticketed.find((te) => te.slug === e.id),
  })),
  ...ticketed.filter((te) => !ownIds.has(te.slug)).map((te) => ({
    key: te.slug, kind: t(lang, 'events.public.kind'), title: te.title, body: te.description ?? '',
    cta: 'notify' as const, tickets: te,
  })),
].map((row) => (row.tickets ? { ...row, priceKr: row.tickets.priceKr } : row));

// Photos staff attached to the event in EDB, shown as a small pile of prints
// to the left of it. EDB lists them front to back; PhotoStack lays them back
// to front. When any event has photos, every row keeps the column so the
// titles line up.
const photosOf = (row: Row) => [...(row.tickets?.photos ?? [])].reverse().map((p) => ({ src: p.url, alt: p.alt }));
const photoColumn = rows.some((row) => photosOf(row).length > 0);

// The text under a title. A course that sells tickets shows EDB's full
// description (staff keep it there), in Danish only: EDB has no English copy,
// so /en keeps the site's own. Laid out like Rails' simple_format: a blank
// line starts a paragraph, a single newline breaks the line.
const bodyText = (row: Row) => (lang === 'da' && row.tickets?.description?.trim()) || row.body;
const paragraphs = (text: string) => text.trim().split(/\n\s*\n/).map((p) => p.split('\n'));

const onSale = (row: Row) => !!row.tickets?.dates.some((d) => !d.soldOut);

// A date card's three lines: "tor", "14. jan", "18.30–20.30".
function cardParts(startsAt: string, endsAt: string | null) {
  const locale = lang === 'da' ? 'da-DK' : 'en-GB';
  const tz = 'Europe/Copenhagen';
  const at = new Date(startsAt);
  const weekday = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: tz }).format(at).replace('.', '');
  const day = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', timeZone: tz }).format(at).replace(/\.$/, '');
  const clock = (iso: string) => new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit', timeZone: tz })
    .format(new Date(iso)).replace(':', lang === 'da' ? '.' : ':');
  return { weekday, day, time: endsAt ? `${clock(startsAt)}–${clock(endsAt)}` : clock(startsAt) };
}

// "Kun 2 pladser tilbage" once a date is down to its last three seats.
const FEW_SEATS = 3;
const isFew = (d: TicketDate) => !d.soldOut && d.seatsLeft !== null && d.seatsLeft <= FEW_SEATS;
const fewSeats = (left: number) =>
  left === 1 ? t(lang, 'events.public.fewSeatsOne') : t(lang, 'events.public.fewSeats').replace('{n}', String(left));

const cases = (['case1', 'case2', 'case3', 'case4'] as const).map((c) => t(lang, `events.${c}`));
const eventPhotos = lang === 'da'
  ? [
      { src: morgenmad, alt: 'Kaffe og morgenmad i vindueskarmen' },
      { src: bagBaren, alt: 'Barista bag baren hos morˢ' },
      { src: baren, alt: 'Gæster i kø ved baren' },
      { src: cafe, alt: 'Gæster ved bordene i kaffebaren' },
    ]
  : [
      { src: morgenmad, alt: 'Coffee and breakfast on the window sill' },
      { src: bagBaren, alt: 'Barista behind the bar at morˢ' },
      { src: baren, alt: 'Guests queueing at the bar' },
      { src: cafe, alt: 'Guests at the tables in the coffee bar' },
    ];
const asks = (['what', 'when', 'howMany', 'wishes'] as const).map((k) => t(lang, `events.contact.${k}`));
---

<PageHero title={t(lang, 'events.title')}>
  <!-- Points people who came to book, not to join, straight down the page. -->
  <a
    href="#eget-event"
    class="group mt-10 flex items-center justify-between gap-4 text-left rounded-mors bg-cream-dark px-5 py-4 border border-deep-red/10 hover:border-deep-red/30 transition-colors"
  >
    <span class="font-body font-medium text-deep-red">{t(lang, 'events.private.banner')}</span>
    <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 shrink-0 text-deep-red transition-transform duration-300 group-hover:translate-y-0.5">
      <line x1="7" y1="2" x2="7" y2="12" />
      <polyline points="3,8 7,12 11,8" />
    </svg>
  </a>
</PageHero>

<!-- Our own events. Deliberately short. An event that sells tickets in EDB
     shows its dates and a buy button; the rest sign up over e-mail. -->
<section class="bg-warm-white py-16 md:py-20">
  <Container>
    <div
      data-animate-on-scroll
      class="max-w-3xl mx-auto opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out"
    >
      {rows.length === 0 ? (
        <p class="mt-6 rounded-lg border border-dashed border-ink/15 px-8 py-8 text-center font-body font-light text-ink-light">
          {t(lang, 'events.public.empty')}
        </p>
      ) : (
        <ul class="divide-y divide-ink/10">
          {rows.map((row) => (
            <li class="py-8 first:pt-0 last:pb-0 flex flex-col md:flex-row md:items-start md:justify-between gap-6">
              {photoColumn && (
                photosOf(row).length > 0
                  ? <PhotoStack photos={photosOf(row)} class="w-44 md:w-36 shrink-0 md:-ml-4 md:-mt-4" />
                  : <div class="hidden md:block w-36 shrink-0 md:-ml-4" aria-hidden="true"></div>
              )}
              <div class="min-w-0 md:flex-1">
                <p class="inline-block rounded-full bg-sage/15 px-2.5 py-1 font-body font-medium text-[10px] uppercase tracking-[0.15em] text-[#4d5c44]">{row.kind}</p>
                <h3 class="font-display font-semibold text-xl tracking-normal text-deep-red mt-2">{row.title}</h3>
                {bodyText(row) && (
                  <!-- Shown in full without JavaScript; the script below folds a long one. -->
                  <div
                    id={`beskrivelse-${row.key}`}
                    data-more
                    data-more-label={t(lang, 'events.public.more')}
                    data-less-label={t(lang, 'events.public.less')}
                    class="event-more font-body font-light text-ink-light leading-relaxed mt-3 max-w-xl space-y-3"
                  >
                    {paragraphs(bodyText(row)).map((lines) => (
                      <p>{lines.map((line, i) => (i === 0 ? line : [<br />, line]))}</p>
                    ))}
                  </div>
                )}
                {row.tickets ? (
                  <!-- One small card per date. Cards in a row share a height; a date
                       down to its last seats gets a red band along the bottom. EDB's
                       date picker (event_tickets/show + .date-card in shop.css) draws
                       the same card: change the two together. -->
                  <ul class="mt-5 grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(7rem,1fr))] gap-2" aria-label={t(lang, 'events.public.dates')}>
                    {row.tickets.dates.map((d) => {
                      const p = cardParts(d.startsAt, d.endsAt);
                      const few = isFew(d);
                      const body = (
                        <Fragment>
                          <span class="px-3 pt-2.5 font-body font-medium text-[10px] leading-[1.4] uppercase tracking-[0.15em] text-ink-muted">{p.weekday}</span>
                          <time datetime={d.startsAt} class:list={['px-3 font-display font-semibold text-[15px] leading-tight', d.soldOut ? 'text-ink-muted line-through decoration-ink/30' : 'text-deep-red']}>{p.day}</time>
                          <span class="px-3 pb-2.5 font-body text-xs leading-[1.4] tabular-nums text-ink-light">{p.time}</span>
                          {few && (
                            <span class="mt-auto bg-deep-red px-3 py-1.5 font-body font-medium text-[11px] leading-snug text-cream">{fewSeats(d.seatsLeft!)}</span>
                          )}
                          {d.soldOut && (
                            <span class="mt-auto border-t border-ink/10 px-3 py-1.5 font-body font-medium text-[11px] leading-snug text-ink-muted">{t(lang, 'events.public.soldOut')}</span>
                          )}
                        </Fragment>
                      );
                      return (
                        <li class="flex">
                          {d.soldOut ? (
                            <div class="flex w-full flex-col overflow-hidden rounded-mors border border-ink/10 bg-cream/40">{body}</div>
                          ) : (
                            <a
                              href={d.url}
                              class:list={[
                                'flex w-full flex-col overflow-hidden rounded-mors border bg-warm-white transition-colors hover:border-deep-red focus-visible:border-deep-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-red',
                                few ? 'border-deep-red/60' : 'border-ink/15',
                              ]}
                            >
                              {body}
                            </a>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="font-body font-medium text-sm text-ink mt-4">
                    {row.date ? <time datetime={row.date}>{eventDate(row.date, row.time)}</time> : t(lang, 'events.public.soon')}
                  </p>
                )}
                {(row.duration || row.priceKr) && (
                  <p class="font-body font-light text-sm text-ink-light mt-2">
                    {[row.duration, row.priceKr && `${row.priceKr.toLocaleString(lang === 'da' ? 'da-DK' : 'en-GB')} ${t(lang, 'events.public.perPerson')}`].filter(Boolean).join(' · ')}
                  </p>
                )}
              </div>
              <div class="shrink-0 self-start flex flex-col items-start md:items-end gap-2">
                {onSale(row) ? (
                  <a
                    href={row.tickets!.url}
                    class="inline-flex items-center justify-center rounded-full px-6 py-3 font-body font-medium text-xs uppercase tracking-widest transition-colors bg-deep-red text-cream hover:bg-ink"
                  >
                    {t(lang, 'events.public.buy')}<span class="sr-only">: {row.title}</span>
                  </a>
                ) : (
                  <a
                    href={row.cta === 'signup' ? mailto(`${t(lang, 'events.public.signupSubject')}: ${row.title}`) : followUrl(row.key)}
                    data-follow={row.cta === 'signup' ? undefined : ''}
                    class:list={[
                      'inline-flex items-center justify-center rounded-full px-6 py-3 font-body font-medium text-xs uppercase tracking-widest transition-colors',
                      row.cta === 'signup'
                        ? 'bg-deep-red text-cream hover:bg-ink'
                        : 'border border-deep-red/30 text-deep-red hover:bg-deep-red hover:text-cream',
                    ]}
                  >
                    {t(lang, row.cta === 'signup' ? 'events.public.signup' : 'events.public.notify')}
                  </a>
                )}
                {onSale(row) && t(lang, 'events.public.danishOnly') && (
                  <p class="font-body font-light text-xs text-ink-muted">{t(lang, 'events.public.danishOnly')}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>

<FollowDialog lang={lang} />

<!-- Hosting your own: never just the room — we run the bar, with food and
     drinks. The examples are the kinds of events that sit outside our own
     opening hours as a rule of thumb, without promising any times. -->
<section id="eget-event" class="bg-cream py-20 md:py-28 scroll-mt-20">
  <Container>
    <div
      data-animate-on-scroll
      class="max-w-3xl mx-auto opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out"
    >
      <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] sm:items-center sm:gap-10">
        <div>
          <h2 class="font-display font-bold text-lg md:text-xl uppercase text-deep-red">{t(lang, 'events.private.title')}</h2>
          <p class="font-body font-light text-ink-light leading-relaxed mt-2">{t(lang, 'events.private.lead')}</p>
          <p class="font-body font-light text-ink-light mt-5">{t(lang, 'events.private.examples')}</p>
          <ul class="mt-2 space-y-1 font-body text-ink">
            {cases.map((c) => (
              <li class="flex gap-3"><span class="text-deep-red" aria-hidden="true">–</span>{c}</li>
            ))}
          </ul>
        </div>
        <PhotoStack photos={eventPhotos} class="w-56 sm:w-full mx-auto" />
      </div>

      <!-- How to ask: the address is the headline, and the list says what to
           put in the mail so the first reply can be a proposal. -->
      <div class="mt-16 text-center">
        <a
          href={mailto(t(lang, 'events.contact.subject'))}
          class="inline-block font-display font-medium text-3xl sm:text-4xl md:text-5xl text-deep-red break-all underline decoration-deep-red/25 decoration-2 underline-offset-[0.2em] hover:decoration-deep-red transition-colors"
        >
          {config.email}
        </a>

        <p class="mt-10 font-body text-xs uppercase tracking-[0.2em] text-ink-muted">{t(lang, 'events.contact.title')}</p>
        <ul class="mt-4 inline-flex flex-col gap-1.5 text-left font-body font-light text-ink-light">
          {asks.map((ask) => (
            <li class="flex gap-3"><span class="text-deep-red" aria-hidden="true">–</span>{ask}</li>
          ))}
        </ul>

        <p class="mt-8 font-body font-light text-sm text-ink-muted leading-relaxed">
          {t(lang, 'events.contact.after')}
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  /* "Læs mere": the script folds a long description under a fade. */
  .event-more.is-folded:not(.is-open) {
    max-height: var(--fold);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
</style>

<script>
  // Fold a description taller than about six lines, with a button to open it.
  // Without JavaScript the full text simply shows.
  document.querySelectorAll<HTMLElement>('[data-more]').forEach((box) => {
    const line = parseFloat(getComputedStyle(box).lineHeight) || 26;
    const fold = Math.round(line * 6);
    if (box.scrollHeight <= fold + line * 2) return; // not worth folding two lines

    const more = box.dataset.moreLabel ?? 'Læs mere';
    const less = box.dataset.lessLabel ?? 'Vis mindre';
    box.style.setProperty('--fold', `${fold}px`);
    box.classList.add('is-folded');

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'mt-2 inline-flex items-center gap-1.5 font-body font-medium text-sm text-deep-red underline decoration-deep-red/30 underline-offset-4 hover:decoration-deep-red';
    btn.setAttribute('aria-controls', box.id);
    btn.setAttribute('aria-expanded', 'false');
    const label = document.createElement('span');
    label.textContent = more;
    const arrow = document.createElement('span');
    arrow.setAttribute('aria-hidden', 'true');
    arrow.className = 'transition-transform duration-200 motion-reduce:transition-none';
    arrow.textContent = '↓';
    btn.append(label, arrow);
    box.after(btn);

    btn.addEventListener('click', () => {
      const open = box.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? less : more;
      arrow.style.transform = open ? 'rotate(180deg)' : '';
      if (!open) box.scrollIntoView({ block: 'nearest' });
    });
  });
</script>
