---
// "Giv mig besked" as a modal: EDB's follow page in an iframe (?embed=1). Any
// link with data-follow opens it; without JavaScript, or with a modifier key,
// the link simply goes to the standalone page.
//
// EDB's embedded page posts { source: 'mors-embed', height } as it resizes, so
// the iframe never scrolls, and { close: true } from its "Luk" button. EDB
// only lets mors.coffee (and localhost:4321 in development) frame it.
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { config } from '../../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const origin = new URL(config.eventsUrl).origin;
---

<dialog
  id="follow-dialog"
  data-origin={origin}
  aria-label={t(lang, 'events.public.notify')}
  class="w-[calc(100%-2rem)] max-w-lg max-h-[calc(100dvh-2rem)] p-0 rounded-mors bg-cream text-ink shadow-2xl backdrop:bg-ink/50 overflow-y-auto overscroll-contain"
>
  <div class="relative">
    <button
      type="button"
      data-follow-close
      class="absolute right-3 top-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full text-ink-light hover:bg-ink/5 hover:text-deep-red transition-colors"
    >
      <span class="sr-only">{t(lang, 'events.public.close')}</span>
      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="h-4 w-4">
        <line x1="3" y1="3" x2="11" y2="11" />
        <line x1="11" y1="3" x2="3" y2="11" />
      </svg>
    </button>
    <iframe title={t(lang, 'events.public.notify')} class="block w-full h-[26rem] border-0 bg-cream"></iframe>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('follow-dialog') as HTMLDialogElement | null;
  const frame = dialog?.querySelector('iframe');

  if (dialog && frame && typeof dialog.showModal === 'function') {
    const origin = dialog.dataset.origin;
    let opener: HTMLElement | null = null;

    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-follow]');
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();

      const url = new URL(link.href);
      url.searchParams.set('embed', '1');
      frame.style.height = '';
      frame.src = url.href;
      opener = link;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });

    // Browsers ignore autofocus inside a cross-origin frame. Focusing the
    // iframe element hands focus to its page, which moves it to the e-mail field.
    frame.addEventListener('load', () => {
      if (dialog.open) frame.focus();
    });

    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== frame.contentWindow) return;
      const data = event.data;
      if (!data || data.source !== 'mors-embed') return;
      if (typeof data.height === 'number' && data.height > 0) frame.style.height = `${data.height}px`;
      if (data.close) dialog.close();
    });

    dialog.querySelector('[data-follow-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      frame.src = 'about:blank';
      opener?.focus();
    });
  }
</script>
