---
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { config } from '../../config';
import { openPositions, applicationMailto } from '../../data/jobs';
import Container from '../shared/Container.astro';
import PageHero from '../shared/PageHero.astro';
import CTAButton from '../shared/CTAButton.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const count = openPositions.length;
const countLabel = `${count} ${t(lang, count === 1 ? 'jobs.open.position' : 'jobs.open.positions')}`;
const unsolicitedMailto = applicationMailto(t(lang, 'jobs.unsolicited.subject'));
---

<PageHero title={t(lang, 'jobs.title')} lead={t(lang, 'jobs.lead')} />

<!-- Open positions. The list is shown even when empty, so "nothing open" is
     an answer rather than an absence. -->
<section class="bg-warm-white py-24 md:py-32">
  <Container>
    <div
      data-animate-on-scroll
      class="max-w-3xl mx-auto opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out"
    >

      <div class="flex items-baseline justify-between gap-6 border-b border-ink/10 pb-4">
        <h2 class="font-body text-xs uppercase tracking-[0.2em] text-ink-muted">
          {t(lang, 'jobs.open.title')}
        </h2>
        <span class="font-body font-normal text-xs uppercase tracking-[0.15em] text-sage whitespace-nowrap">
          {countLabel}
        </span>
      </div>

      {count === 0 ? (
        <p class="mt-6 rounded-lg border border-dashed border-ink/15 px-8 py-8 text-center font-body font-light text-ink-light">
          {t(lang, 'jobs.open.empty')}
        </p>
      ) : (
        <ul>
          {openPositions.map((job) => (
            <li class="border-b border-ink/10 py-8 flex flex-col md:flex-row md:items-start md:justify-between gap-6">
              <div>
                <h3 class="font-display font-semibold text-xl tracking-normal text-deep-red">
                  {job.title[lang]}
                </h3>
                <p class="font-body font-normal text-sm uppercase tracking-[0.15em] text-sage mt-2">
                  {job.hours[lang]}
                </p>
                <p class="font-body font-light text-ink-light leading-relaxed mt-4 max-w-xl">
                  {job.summary[lang]}
                </p>
              </div>
              <CTAButton
                href={applicationMailto(job.title[lang])}
                variant="outline"
                label={t(lang, 'jobs.open.apply')}
                class="shrink-0 self-start"
              />
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>

<!-- Unsolicited applications. The address is the headline, so nobody has to
     go looking and fall back on the general inbox. -->
<section class="bg-cream py-24 md:py-32">
  <Container>
    <div
      data-animate-on-scroll
      class="max-w-2xl mx-auto text-center opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out"
    >
      <h2 class="font-body text-xs uppercase tracking-[0.2em] text-ink-muted mb-6">
        {t(lang, 'jobs.unsolicited.title')}
      </h2>
      <p class="font-body font-light text-lg text-ink-light leading-relaxed mb-8">
        {t(lang, 'jobs.unsolicited.body')}
      </p>

      <a
        href={unsolicitedMailto}
        class="inline-block font-display font-medium text-3xl sm:text-4xl md:text-5xl text-deep-red break-all underline decoration-deep-red/25 decoration-2 underline-offset-[0.2em] hover:decoration-deep-red transition-colors"
      >
        {config.jobEmail}
      </a>

      <p class="mt-10 font-body font-light text-sm text-ink-muted leading-relaxed max-w-xl mx-auto">
        {t(lang, 'jobs.consent')}
      </p>
    </div>
  </Container>
</section>
