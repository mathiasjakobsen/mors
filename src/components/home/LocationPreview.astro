---
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { config } from '../../config';
import Container from '../shared/Container.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import { getHoursSummary } from '../../data/hours';
import CTAButton from '../shared/CTAButton.astro';
import MapEmbed from '../shared/MapEmbed.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Directions from wherever the visitor is: Google Maps' documented URL with
// only a destination routes from the current location (and opens the app on
// phones).
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `morˢ, ${config.address.street}, ${config.address.zip} ${config.address.city}`,
)}`;
// "Man-Fre: 7:30-18:00" → ["Man–Fre", "7:30–18:00"], with proper dashes.
const hours = getHoursSummary(lang).map((line) => line.replace(/-/g, '–').split(': '));
const label = 'font-body text-xs uppercase tracking-[0.2em] text-ink-muted mb-3';
const value = 'font-body font-normal text-ink leading-relaxed';
---

<!-- Address, hours and the way here in one row (stacked on phones), then
     the map. One label style and one value style throughout. -->
<section id="hours" class="bg-cream pt-12 md:pt-16">
  <Container>
    <SectionHeading title={t(lang, 'home.location.title')} compact />

    <div data-animate-on-scroll class="max-w-4xl mx-auto mb-12 md:mb-14 grid gap-8 text-center sm:grid-cols-3 sm:text-left opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out">
      <div>
        <h3 class={label}>{t(lang, 'contact.address')}</h3>
        <address class:list={['not-italic', value]}>
          {config.address.street}<br />
          {config.address.zip} {config.address.city}<br />
          {config.address.country[lang]}
        </address>
      </div>

      <div>
        <h3 class={label}>{t(lang, 'hours.title')}</h3>
        <dl class:list={['inline-grid grid-cols-[auto_auto] gap-x-4 text-left', value]}>
          {hours.map(([days, time]) => (
            <>
              <dt>{days}</dt>
              <dd class="tabular-nums">{time}</dd>
            </>
          ))}
        </dl>
      </div>

      <!-- Centred in its column, both ways, so it sits level with the two text blocks. -->
      <div class="flex items-center justify-center">
        <CTAButton href={directionsHref} variant="primary" label={t(lang, 'hero.cta.visit')} external />
      </div>
    </div>

    <div class="mb-12 md:mb-16 flex justify-center">
      <a
        href="https://europeancoffeetrip.com/cafe/mors-aarhus/"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 rounded-mors bg-[#1c0fb9] px-4 py-2.5 transition-colors hover:bg-[#1709a3]"
      >
        <img src="/brand/partners/ect-logo.png" alt="European Coffee Trip" width="276" height="82" class="h-5 w-auto" loading="lazy" />
        <span class="font-body text-[10px] uppercase tracking-[0.2em] text-white/70 group-hover:text-white transition-colors">
          {lang === 'da' ? 'Anbefalet på' : 'Featured on'}
        </span>
      </a>
    </div>
  </Container>

  <!-- Full-width map -->
  <div data-animate-on-scroll class="w-full h-[260px] md:h-[320px] opacity-0 translate-y-[30px] transition-all duration-[800ms] ease-out">
    <MapEmbed lang={lang} />
  </div>
</section>
