---
import PageLayout from '../layouts/PageLayout.astro';
import JobsPageBody from '../components/jobs/JobsPageBody.astro';
import { t } from '../i18n/ui';

const lang = 'da';
---

<PageLayout
  title={t(lang, 'seo.jobs.title')}
  description={t(lang, 'seo.jobs.description')}
  lang={lang}
  canonicalPath="/job"
>
  <JobsPageBody lang={lang} />
</PageLayout>
