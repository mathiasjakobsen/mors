---
import PageLayout from '../layouts/PageLayout.astro';
import StampCardPageBody from '../components/pages/StampCardPageBody.astro';
import { t } from '../i18n/ui';

const lang = 'da';
---

<PageLayout
  title={t(lang, 'seo.stampcard.title')}
  description={t(lang, 'seo.stampcard.description')}
  lang={lang}
  canonicalPath="/stempelkort"
>
  <StampCardPageBody lang={lang} />
</PageLayout>
