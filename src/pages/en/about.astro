---
import { Picture } from 'astro:assets';
import founders from '../../assets/mors-founders.jpg';
import bindingsvaerk from '../../assets/mors-bindingsvaerk.jpg';
import bagBaren from '../../assets/mors-bag-baren.jpg';
import morgenmad from '../../assets/mors-morgenmad.jpg';
import doer from '../../assets/mors-doer.jpg';
import baren from '../../assets/mors-baren.jpg';
import cafe from '../../assets/mors-cafe.jpg';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import { t } from '../../i18n/ui';
import Container from '../../components/shared/Container.astro';
import AboutHouse from '../../components/about/AboutHouse.astro';
import AboutTeam from '../../components/about/AboutTeam.astro';

const lang = 'en';

const gallery = [
  { src: bindingsvaerk, title: 'Listed half-timbering from 1702' },
  { src: bagBaren,      title: 'Behind the bar' },
  { src: morgenmad,     title: 'Breakfast in the sun' },
  { src: doer,          title: 'The door is open' },
  { src: baren,         title: 'While we brew' },
  { src: cafe,          title: 'Room for a chat' },
];
---

<PageLayout
  title={t(lang, 'seo.about.title')}
  description={t(lang, 'seo.about.description')}
  lang={lang}
  canonicalPath="/en/about"
>
  <PageHero title="About morˢ" image={{ src: founders, alt: 'Mathias and Johanne, two of the founders of morˢ' }} />

  <AboutTeam lang={lang} />
  <AboutHouse lang={lang} />

  <!-- Gallery -->
  <section class="bg-warm-white py-24 md:py-40">
    <Container>
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 md:gap-8">
        {gallery.map((item) => (
          <figure class="animate-on-scroll mb-6 md:mb-8 break-inside-avoid">
            <div class="overflow-hidden rounded-mors bg-cream">
              <Picture
                src={item.src}
                alt={item.title}
                formats={['avif', 'webp']}
                widths={[400, 640, 800, 1024, 1280]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-cover transition-transform duration-[1200ms] ease-out hover:scale-[1.03]"
              />
            </div>
            <figcaption class="mt-3 font-body text-xs uppercase tracking-[0.2em] text-ink-muted">
              {item.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </section>
</PageLayout>
