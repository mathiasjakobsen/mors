---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../i18n/ui';
import { cafeSchema } from '../../utils/jsonld';
import Hero from '../../components/home/Hero.astro';
import GiftCardsPreview from '../../components/home/GiftCardsPreview.astro';
import Founders from '../../components/home/Founders.astro';
import FeaturedBeans from '../../components/home/FeaturedBeans.astro';
import { heroBackground } from '../../data/hero';
import LocationPreview from '../../components/home/LocationPreview.astro';

const lang = 'en';
---

<PageLayout
  title={t(lang, 'seo.home.title')}
  description={t(lang, 'seo.home.description')}
  lang={lang}
  canonicalPath="/en/"
  jsonLd={cafeSchema(lang)}
  preloadImage="/brand/mors-wordmark-white.svg"
  overlayHeader
>
  <Hero lang={lang} background={heroBackground} />
  <GiftCardsPreview lang={lang} />
  <Founders lang={lang} />
  <FeaturedBeans lang={lang} />
  <LocationPreview lang={lang} />
</PageLayout>
