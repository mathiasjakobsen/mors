---
import ContentIndexPage from '../../components/content/ContentIndexPage.astro';
import { t } from '../../i18n/ui';
import { getViden, videnPath, SECTION_ROOTS } from '../../lib/content';

// Only built once the section has something published: an empty index is a
// thin page, and noindex pages don't belong in the sitemap.
export async function getStaticPaths() {
  const entries = await getViden('da');
  return entries.length ? [{ params: { index: undefined }, props: { entries } }] : [];
}

const lang = 'da';
const { entries } = Astro.props;
---

<ContentIndexPage
  lang={lang}
  title={t(lang, 'seo.knowledge.title')}
  description={t(lang, 'seo.knowledge.description')}
  heading={t(lang, 'nav.knowledge')}
  lead="Det vi har lært bag baren om bønner, vand og bryggemetoder – skrevet ned, så du kan bruge det derhjemme."
  canonicalPath={SECTION_ROOTS.viden.da}
  alternatePath={SECTION_ROOTS.viden.en}
  items={entries.map((e) => ({ href: videnPath(lang, e.data.slug), title: e.data.title, description: e.data.description }))}
/>
