---
import PageLayout from '../layouts/PageLayout.astro';
import EventsPageBody from '../components/events/EventsPageBody.astro';
import { t } from '../i18n/ui';

const lang = 'da';
---

<PageLayout
  title={t(lang, 'seo.events.title')}
  description={t(lang, 'seo.events.description')}
  lang={lang}
  canonicalPath="/events"
>
  <EventsPageBody lang={lang} />
</PageLayout>
